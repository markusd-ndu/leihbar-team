# Kopiere diese Datei zu `.env.local` und trage deine Werte ein.
# `.env.local` wird NICHT committed (steht in .gitignore). Niemals Keys in den Code schreiben.

# Supabase (Tag 2) – im Supabase-Projekt oben auf „Connect“ klicken, Framework Next.js wählen: dort stehen URL und Publishable Key
NEXT_PUBLIC_SUPABASE_URL=
# Publishable Key (beginnt mit sb_publishable_) – darf in den Browser, durch Row Level Security geschützt
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# KI-Feature (LEI-5) – Key kommt von Markus, nur im Backend verwenden
ANTHROPIC_API_KEY=

# Nur im Backend (LEI-6: Zeitplan setzt alte Anfragen auf „abgelaufen“). Secret Key (sb_secret_…), nie mit NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# LEI-6: Geheimnis, mit dem Vercel Cron den Zeitplan aufruft – ohne es antwortet die Route mit 401. Wert von Markus.
CRON_SECRET=
